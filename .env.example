# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"                 # planning, drafting and repair
OPENAI_ANALYSIS_MODEL="gpt-4o-mini"   # cheaper semantic scan pass

# --- Database (Postgres: LangGraph checkpoints) ---------------------------
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5433/agent_db"

# --- Redis (idempotency + rate limiting) ----------------------------------
REDIS_URL="redis://localhost:6379"

# --- GitHub App -----------------------------------------------------------
# App path: needed for the agent to push commits to a PR branch.
GITHUB_APP_ID="123456"
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET="your_webhook_secret_here"
# Fallback for local runs without an App installation (read-only is enough
# for analysis; pushing requires write scope).
GITHUB_TOKEN=""

# --- Agent behaviour ------------------------------------------------------
# Risk score at or below which a fix is committed without a human.
AUTO_COMMIT_THRESHOLD=0.15
# Self-correction attempts per proposal inside the sandbox subgraph.
MAX_REPAIR_ATTEMPTS=2
# How many times the plan may be revised after verification failures.
MAX_REPLAN_ROUNDS=1
# Hard ceiling on estimated LLM tokens per review (never prompts, just stops).
TOKEN_BUDGET=120000
# Wall-clock limit for the project's test command in the sandbox.
TEST_TIMEOUT_SECONDS=300

# --- Observability --------------------------------------------------------
LOG_LEVEL="INFO"
LOG_FORMAT="json"                     # "plain" for local CLI runs
# Optional LLM tracing. LangChain reads these directly from the environment.
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="autonomous-code-reviewer"
